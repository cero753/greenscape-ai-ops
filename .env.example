# Supabase — project database (server-side only, used by Netlify Functions)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (Dashboard > Project Settings > API Keys). NEVER expose client-side.
# All tables have RLS enabled with no anon policies; only the service role can read/write.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — proposal generation (server-side only)
# Model: claude-sonnet-4-6. Typical proposal generation: ~4k input + ~1.5k output tokens ≈ $0.03/proposal.
ANTHROPIC_API_KEY=sk-ant-...

# Slack — incoming webhook for lead/proposal notifications (optional; app degrades gracefully without it)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Public base URL of the deployed site (used to build client proposal links in Slack messages)
PUBLIC_BASE_URL=http://localhost:8888
